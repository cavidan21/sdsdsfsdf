local invisSaved = {}

local function applyInvisibility()
    local char = LocalPlayer.Character
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") then
            if invisSaved[d] == nil then
                invisSaved[d] = { t = d.Transparency, l = d.LocalTransparencyModifier }
            end
            d.Transparency = 1
            d.LocalTransparencyModifier = 1
        elseif d:IsA("Decal") or d:IsA("Texture") then
            if invisSaved[d] == nil then invisSaved[d] = { t = d.Transparency } end
            d.Transparency = 1
        elseif d:IsA("BillboardGui") then
            if invisSaved[d] == nil then invisSaved[d] = { e = d.Enabled } end
            d.Enabled = false
        end
    end
end

local function restoreInvisibility()
    for d, s in pairs(invisSaved) do
        if d and d.Parent then
            pcall(function()
                if d:IsA("BasePart") then
                    d.Transparency = s.t
                    d.LocalTransparencyModifier = s.l
                elseif d:IsA("Decal") or d:IsA("Texture") then
                    d.Transparency = s.t
                elseif d:IsA("BillboardGui") then
                    d.Enabled = s.e
                end
            end)
        end
    end
    table.clear(invisSaved)
end

local function farmingActive()
    if not State.InvisibleFarm then return false end
    return State.CoinFarm or State.CandyFarm or State.GhostFarm or State.ScavFarm or State.RoundFarm
end

RunService.RenderStepped:Connect(function()
    if not Running then return end
    if farmingActive() then
        applyInvisibility()
    elseif next(invisSaved) ~= nil then
        restoreInvisibility()
    end
end)

local farmReturn = nil

local function anyFarmOn()
    return State.CoinFarm or State.CandyFarm or State.GhostFarm or State.ScavFarm or State.RoundFarm
end

local function onFarmStateChanged()
    if anyFarmOn() then
        if not farmReturn then
            local root = playerRoot()
            if root then farmReturn = root.CFrame end
        end
    elseif farmReturn then
        local root = playerRoot()
        local hum = playerHum()
        if root and hum and hum.Health > 0 then
            pcall(function() root.CFrame = farmReturn end)
        end
        farmReturn = nil
    end
end

-- health guard: if a monster hits us, jump out and hover briefly
task.spawn(function()
    while Running do
        if anyFarmOn() then
            local hum = playerHum()
            if hum then
                if lastHealth == nil then
                    lastHealth = hum.Health
                elseif hum.Health < lastHealth - 3 and os.clock() >= panicUntil then
                    panicEscape()
                end
                lastHealth = hum.Health
            else
                lastHealth = nil
            end
        else
            lastHealth = nil
