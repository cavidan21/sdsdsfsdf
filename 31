                            end
                            task.wait(0.1)
                        end
                        for _, d in ipairs(map:GetDescendants()) do
                            if not State.RoundFarm then break end
                            if os.clock() < panicUntil then break end
                            if d:IsA("BasePart") and d.Name == "Detect" then
                                if safeTeleport(d.Position, 30, true) then
                                    interactions = interactions + 1
                                else
                                    blocked = blocked + 1
