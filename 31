local espPlayer = {}
local espItem = {}

local function destroyEntry(entry)
    if not entry then return end
    if entry.highlight then
        pcall(function() entry.highlight:Destroy() end)
        entry.highlight = nil
    end
    if entry.clones then
        for _, pair in ipairs(entry.clones) do
            if pair.gui then pcall(function() pair.gui:Destroy() end) end
        end
        table.clear(entry.clones)
    end
end

local function ensureHighlight(entry, adornee, color)
    if not adornee or not adornee.Parent then return end
    if not adornee:IsA("BasePart") and not adornee:IsA("Model") then return end
    local hl = entry.highlight
    if not hl or hl.Parent == nil then
        hl = Instance.new("Highlight")
        hl.Name = "PH_Highlight"
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0.35
        hl.Adornee = adornee
        hl.Parent = adornee
        entry.highlight = hl
    end
    hl.FillColor = color
    hl.OutlineColor = color
end

local function findSkinBillboards(char)
    local list = {}
    local skinTag = CollectionService:HasTag(char, "SkinAnim")
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BillboardGui") and d.Enabled and not string.find(d.Name, "PH_", 1, true) then
            local imgs = {}
            for _, im in ipairs(d:GetDescendants()) do
                if im:IsA("ImageLabel") and im.Image ~= "" then
                    table.insert(imgs, im)
                end
            end
            local is2D = false
            if #imgs >= 1 then
                local n = string.lower(imgs[1].Name)
                if string.find(n, "idle", 1, true) or string.find(n, "walk", 1, true) or string.find(n, "skin", 1, true) then
                    is2D = true
                end
            end
            if not is2D and skinTag and #imgs >= 1 then
                is2D = true
            end
            if is2D then table.insert(list, d) end
        end
    end
    return list
end

local function findAnyBillboards(inst)
    local list = {}
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("BillboardGui") and d.Enabled and not string.find(d.Name, "PH_", 1, true) then
            local has = false
            for _, im in ipairs(d:GetDescendants()) do
                if im:IsA("ImageLabel") and im.Image ~= "" then has = true; break end
            end
            if has then table.insert(list, d) end
        end
    end
    return list
end

local function makeChamClone(bb, color)
    if not bb.Parent then return nil end
    local ok, clone = pcall(function() return bb:Clone() end)
    if not ok or not clone then return nil end
    clone.Name = "PH_2DCham"
    clone.AlwaysOnTop = true
    clone.MaxDistance = math.huge
    clone.Enabled = true
    for _, im in ipairs(clone:GetDescendants()) do
        if im:IsA("ImageLabel") then
            im.ImageColor3 = color
            im.ImageTransparency = 0.12
            im.BackgroundTransparency = 1
            im.ZIndex = (im.ZIndex or 1) + 10
        elseif im:IsA("TextLabel") or im:IsA("TextButton") then
            im.Visible = false
        end
    end
    clone.Parent = bb.Parent
    return clone
end

local function syncChamClone(gui, orig, color)
    for _, im in ipairs(gui:GetDescendants()) do
        if im:IsA("ImageLabel") then
            local o = orig:FindFirstChild(im.Name, true)
            if o and o:IsA("ImageLabel") then
                im.Visible = o.Visible
                im.Image = o.Image
                im.ImageColor3 = color
                im.ImageTransparency = math.clamp(o.ImageTransparency, 0.05, 0.85)
                im.BackgroundTransparency = 1
                im.ZIndex = (o.ZIndex or 1) + 10
            end
        elseif im:IsA("TextLabel") or im:IsA("TextButton") then
            im.Visible = false
        end
    end
end

local function syncCloneList(entry, originals, color)
    local existing = {}
    for _, pair in ipairs(entry.clones) do
        existing[pair.orig] = pair
    end
    for _, bb in ipairs(originals) do
        if not existing[bb] then
            local gui = makeChamClone(bb, color)
            if gui then
                local pair = { gui = gui, orig = bb }
                table.insert(entry.clones, pair)
                existing[bb] = pair
            end
        end
    end
    local wanted = {}
    for _, bb in ipairs(originals) do wanted[bb] = true end
    for i = #entry.clones, 1, -1 do
        local pair = entry.clones[i]
        if not wanted[pair.orig] or not pair.gui.Parent or not pair.orig.Parent or not pair.orig.Enabled then
            if pair.gui then pcall(function() pair.gui:Destroy() end) end
            table.remove(entry.clones, i)
        else
            syncChamClone(pair.gui, pair.orig, color)
        end
    end
end

local function updatePlayerESP()
    local targets = {}
    if State.PlayerESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and not isBear(plr) then
                local char = getChar(plr)
                if char and isAlive(char) then targets[char] = State.PlayerColor end
            end
        end
    end
    if State.BearESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and isBear(plr) then
                local char = getChar(plr)
                if char and isAlive(char) then targets[char] = State.BearColor end
            end
        end
    end
    for char, entry in pairs(espPlayer) do
        if not targets[char] or not char.Parent or not isAlive(char) then
            destroyEntry(entry)
            espPlayer[char] = nil
        end
    end
    for char, color in pairs(targets) do
        local entry = espPlayer[char]
        if not entry then
            entry = { clones = {} }
            espPlayer[char] = entry
        end
        ensureHighlight(entry, char, color)
        if State.Sprite2D then
            syncCloneList(entry, findSkinBillboards(char), color)
        else
            for _, pair in ipairs(entry.clones) do
                if pair.gui then pcall(function() pair.gui:Destroy() end) end
            end
            table.clear(entry.clones)
        end
    end
end

local nameTargets = {}
local nameScanAt = 0

local function refreshNameTargets()
    local now = os.clock()
    if now - nameScanAt < 2 then return end
    nameScanAt = now
    table.clear(nameTargets)
    local map = Workspace:FindFirstChild("Map")
    if not map then return end
    for _, d in ipairs(map:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Model") or d:IsA("Tool") then
            local n = string.lower(d.Name)
            if string.find(n, "cheese", 1, true) then
                nameTargets[d] = "cheese"
            elseif string.find(n, "burger", 1, true) then
                nameTargets[d] = "burger"
            elseif n == "generator" then
                nameTargets[d] = "puzzle"
            end
        end
    end
end

local function updateItemESP()
    local targets = {}
    local function add(inst, color, sprite)
        if inst and inst.Parent and not targets[inst] then
            targets[inst] = { color = color, sprite = sprite }
        end
    end
    if State.ItemESP then
        for _, d in ipairs(CollectionService:GetTagged("OBJ_Collectable")) do
            add(d, State.ColorCodeItems and ItemColors.candy or State.ItemColor, false)
        end
        for _, d in ipairs(CollectionService:GetTagged("OBJ_Ghost")) do
            local color = State.ItemColor
            if State.ColorCodeItems then
                color = isCandyGhost(d) and ItemColors.ghost or ItemColors.danger
            end
            add(d, color, true)
        end
        for _, d in ipairs(CollectionService:GetTagged("_ScavengerHuntItem")) do
            add(d, State.ColorCodeItems and ItemColors.skull or State.ItemColor, false)
        end
        for _, d in ipairs(CollectionService:GetTagged("_RBLXHalloweenCollect")) do
            add(d, State.ColorCodeItems and ItemColors.event or State.ItemColor, false)
        end
        for _, d in ipairs(CollectionService:GetTagged("_HallowBearPlushCollectRender")) do
            add(d, State.ColorCodeItems and ItemColors.event or State.ItemColor, false)
        end
        for _, d in ipairs(CollectionService:GetTagged("TreasureChest")) do
            add(d, State.ColorCodeItems and ItemColors.chest or State.ItemColor, false)
        end
        for _, d in ipairs(CollectionService:GetTagged("_PuzzleSpawner")) do
            add(d, State.ColorCodeItems and ItemColors.puzzle or State.ItemColor, false)
        end
        for _, d in ipairs(CollectionService:GetTagged("_SurvivorInteractable")) do
            local parent = d:IsA("ClickDetector") and d.Parent or d
            add(parent, State.ColorCodeItems and ItemColors.puzzle or State.ItemColor, false)
        end
        refreshNameTargets()
        for inst, kind in pairs(nameTargets) do
            local color = State.ItemColor
            if State.ColorCodeItems then color = ItemColors[kind] or State.ItemColor end
            add(inst, color, false)
        end
    end
    for inst, entry in pairs(espItem) do
        if not targets[inst] or not inst.Parent then
            destroyEntry(entry)
            espItem[inst] = nil
        end
    end
    for inst, data in pairs(targets) do
        local entry = espItem[inst]
        if not entry then
            entry = { clones = {} }
            espItem[inst] = entry
        end
        local adornee = inst
        if inst:IsA("Tool") then adornee = inst:FindFirstChild("Handle") end
        if adornee then ensureHighlight(entry, adornee, data.color) end
        if data.sprite and State.Sprite2D then
            syncCloneList(entry, findAnyBillboards(inst), data.color)
        else
            for _, pair in ipairs(entry.clones) do
                if pair.gui then pcall(function() pair.gui:Destroy() end) end
            end
            table.clear(entry.clones)
        end
    end
end

