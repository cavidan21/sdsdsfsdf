local speedHumanoid = nil
local speedConns = {}
local speedBv = nil
local speedWasOn = false

local function restoreSpeedConnections()
    for _, c in ipairs(speedConns) do
        pcall(function() c:Enable() end)
        pcall(function() c.Enabled = true end)
    end
    table.clear(speedConns)
end

local function applySpeed()
    if State.SpeedHack then
        speedWasOn = true
        local hum = playerHum()
        if not hum then return end
        if getconnections then
            if speedHumanoid ~= hum then
                restoreSpeedConnections()
                speedHumanoid = hum
                local conns = getconnections(hum:GetPropertyChangedSignal("WalkSpeed"))
                for _, c in ipairs(conns) do
                    pcall(function() c:Disable() end)
                    pcall(function() c.Enabled = false end)
                    table.insert(speedConns, c)
                end
            end
            hum.WalkSpeed = State.SpeedValue
        else
            local root = playerRoot()
            if root then
                if not speedBv or speedBv.Parent ~= root then
                    if speedBv then pcall(function() speedBv:Destroy() end) end
                    speedBv = Instance.new("BodyVelocity")
                    speedBv.Name = "PH_Speed"
                    speedBv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                    speedBv.Parent = root
                end
                speedBv.Velocity = hum.MoveDirection * State.SpeedValue
            end
        end
    elseif speedWasOn then
        speedWasOn = false
        restoreSpeedConnections()
        if speedBv then
            pcall(function() speedBv:Destroy() end)
            speedBv = nil
        end
        local current = playerHum()
        if current then
            pcall(function() current.WalkSpeed = 16 end)
        end
        speedHumanoid = nil
    end
end

RunService:BindToRenderStep("PH_Speed", 1000, applySpeed)

local flyConn = nil
local flyHumanoid = nil

local function stopFly()
    if flyConn then
        pcall(function() flyConn:Disconnect() end)
        flyConn = nil
    end
    local current = playerHum()
    if current then
        pcall(function() current.PlatformStand = false end)
    end
    if flyHumanoid and flyHumanoid ~= current then
        pcall(function() flyHumanoid.PlatformStand = false end)
    end
    flyHumanoid = nil
    local root = playerRoot()
    if root then
        pcall(function()
            root.Anchored = false
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

local function startFly()
    stopFly()
    local root = playerRoot()
    local hum = playerHum()
    if not root or not hum or hum.Health <= 0 then return end
    flyHumanoid = hum
    hum.PlatformStand = true
    flyConn = RunService.RenderStepped:Connect(function(dt)
        if not Running or not State.Fly then return end
        local currentHum = playerHum()
        local currentRoot = playerRoot()
        if not currentHum or not currentRoot or currentHum.Health <= 0 then return end
        currentHum.PlatformStand = true
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end
        if dir.Magnitude > 0 then dir = dir.Unit end
        local move = dir * State.FlySpeed * math.min(dt, 0.15)
        currentRoot.Anchored = true
        currentRoot.CFrame = currentRoot.CFrame + move
        currentRoot.AssemblyLinearVelocity = Vector3.zero
        currentRoot.AssemblyAngularVelocity = Vector3.zero
    end)
end

