        Fluent:Notify({ Title = title, Content = content, Duration = duration or 4 })
    end)
end

--==============================================================
-- Safety: hostile scan / panic escape
--==============================================================
local panicUntil = 0
local hostileCache = {}
local hostileScanAt = 0
local lastHealth = nil

local dangerWords = {
    "monster", "enemy", "hostile", "killer", "horror", "demon", "nightmare",
    "huggy", "wuggy", "siren", "smiler", "smil", "freddy", "chica", "bonnie",
    "foxy", "springtrap", "puppet", "marionette", "slender", "jason", "michael",
    "myers", "chucky", "pennywise", "baldi", "sonic", "exe", "jeff", "granny",
    "oni", "nemesis", "pyramid", "jigsaw", "annabelle", "momo", "wendigo",
    "skinwalker", "rake", "goatman", "jumpscare", "scarecrow", "hazard", "hitbox",
    "hurtbox", "killbrick", "spike", "trap",
}

local function nameLooksHostile(name)
    local n = string.lower(name)
    for _, w in ipairs(dangerWords) do
        if string.find(n, w, 1, true) then return true end
    end
    return false
end

local function isPinkGhost(inst)
    return inst ~= nil and string.find(string.lower(inst.Name), "pink", 1, true) ~= nil
end

local function isCandyGhost(inst)
    local n = string.lower(inst.Name)
    return string.find(n, "pink", 1, true) ~= nil or string.find(n, "candy", 1, true) ~= nil
end

local function instancePos(inst)
    if inst:IsA("Model") then
        local ok, pivot = pcall(function() return inst:GetPivot() end)
        return ok and pivot.Position or nil
    elseif inst:IsA("BasePart") then
        return inst.Position
    end
    return nil
end

local function refreshHostiles()
    local now = os.clock()
    if now - hostileScanAt < 1 then return end
    hostileScanAt = now
    table.clear(hostileCache)
    local seen = {}
    local map = Workspace:FindFirstChild("Map")

    local function addHostile(inst)
        if not inst or seen[inst] or inst == LocalPlayer.Character then return end
        seen[inst] = true
        table.insert(hostileCache, inst)
    end

    local function consider(inst)
        if not inst or seen[inst] or inst == LocalPlayer.Character then return end
        if inst:IsA("Model") and Players:GetPlayerFromCharacter(inst) then return end
        local hostile = false
        if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
            hostile = true
        end
        if not hostile and nameLooksHostile(inst.Name) then
            hostile = true
        end
        if hostile then addHostile(inst) end
    end

    for _, tag in ipairs({ "_MandemStatue", "_Monster", "Monster", "_Enemy", "_Killer" }) do
        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
            if inst:IsDescendantOf(Workspace) then
                if map or tag ~= "_MandemStatue" then addHostile(inst) end
            end
        end
    end

    if map then
        for _, inst in ipairs(map:GetDescendants()) do
            if inst:IsA("Model") or inst:IsA("BasePart") then consider(inst) end
        end
        for _, inst in ipairs(Workspace:GetChildren()) do
            if inst:IsA("Model") and not Players:GetPlayerFromCharacter(inst) then
                consider(inst)
            end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and isBear(plr) and isAlive(plr.Character) then
                addHostile(plr.Character)
            end
        end
    end

    for _, ghost in ipairs(CollectionService:GetTagged("OBJ_Ghost")) do
        if ghost.Parent and not isCandyGhost(ghost) then addHostile(ghost) end
    end
end

local function hostileNear(pos, radius)
    if not State.MonsterScan or not pos then return nil end
    refreshHostiles()
    for _, inst in ipairs(hostileCache) do
        if inst.Parent then
            local p = instancePos(inst)
            if p and (p - pos).Magnitude <= radius then return inst end
        end
    end
    return nil
end

local function panicEscape()
    local now = os.clock()
    if now < panicUntil then return false end
    panicUntil = now + 2.5
    local root = playerRoot()
    if not root then return false end
    pcall(function()
        root.CFrame = root.CFrame + Vector3.new(0, 100, 0)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.Anchored = true
    end)
    task.delay(1.5, function()
        if root and root.Parent then
            pcall(function() root.Anchored = false end)
        end
    end)
    return true
end

local function safeTeleport(pos, radius, checkAfter)
    if os.clock() < panicUntil then return false end
    radius = radius or State.ScanRadius
    if hostileNear(pos, radius) then return false end
    if not teleportTo(pos) then return false end
    if checkAfter ~= false then
        task.wait(0.05)
        local root = playerRoot()
        if root and hostileNear(root.Position, math.min(radius, 28)) then
            panicEscape()
            return false
        end
    end
    return true
end

