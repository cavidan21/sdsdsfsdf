                            if not table.find(progress, name) then
                                local pos = item:IsA("Model") and item:GetPivot().Position or item.Position
                                if safeTeleport(pos + Vector3.new(0, 3, 0), State.ScanRadius, true) then
                                    task.wait(0.4)
                                    local cd = item:FindFirstChildOfClass("ClickDetector") or item:FindFirstChild("ClickDetector", true)
                                    if cd and fireclick then pcall(function() fireclick(cd) end) end
                                    local deadline = os.clock() + 1.2
                                    local got = false
                                    while os.clock() < deadline do
                                        task.wait(0.15)
                                        pcall(function()
                                            progress = PlayerRegistry.PlayerData.ScavengerHunts[hunt].Progress or progress
                                        end)
                                        if table.find(progress, name) then
                                            got = true
                                            break
                                        end
                                    end
                                    if got then
                                        scavFound = scavFound + 1
                                        notify("Skavenge", name .. " collected", 3)
                                    end
                                end
                            end
                        end
                    end
                    local db = Database and Database.ScavengerHunts and Database.ScavengerHunts[hunt]
                    if db and db.List and not data.Finished and os.clock() - lastScavRedeem > 5 then
                        local all = true
                        for key in pairs(db.List) do
                            if not table.find(progress, key) then
                                all = false
                                break
                            end
                        end
                        if all then
                            lastScavRedeem = os.clock()
                            local rf = Remotes:FindFirstChild("RF/ScavengerHunt_Redeem")
                            if rf then
                                local ok, res = pcall(function() return rf:InvokeServer(hunt) end)
                                if ok and res then
                                    notify("Skavenge Complete", "Skelebear + Burial unlocked!", 6)
                                end
                            end
                        end
                    end
                    setStatus(UI.scav, "Found: " .. scavFound .. " | " .. (#progress > 0 and table.concat(progress, ", ") or "none") .. (data.Finished and " | Redeemed" or ""))
                end
            else
                setStatus(UI.scav, "No active hunt.")
            end
            task.wait(1)
        else
            task.wait(0.5)
        end
    end
end)

