                                    interactions = interactions + 1
                                else
                                    blocked = blocked + 1
                                end
                                task.wait(0.1)
                            end
                        end
                        for _, d in ipairs(roundCache.prompts) do
                            if not State.RoundFarm then break end
                            if os.clock() < panicUntil then break end
                            local parent = d.Parent
                            local pos = nil
                            if parent then
                                if parent:IsA("BasePart") then
                                    pos = parent.Position
