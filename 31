local function currency(field)
    if not PlayerRegistry then return 0 end
    local ok, value = pcall(function() return PlayerRegistry.PlayerData[field] end)
    return ok and tonumber(value) or 0
end

local function potData()
    if not PlayerRegistry then return nil end
    local ok, value = pcall(function()
        return PlayerRegistry.PlayerData.CommunityPots and PlayerRegistry.PlayerData.CommunityPots.Hallow26
