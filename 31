unload = function()
    if not Running then return end
    Running = false
    pcall(function() setFullbright(false) end)
    pcall(function() setXray(false) end)
    pcall(stopFly)
    pcall(restoreInvisibility)
    pcall(restoreSpeedConnections)
    speedWasOn = false
    speedHumanoid = nil
    local currentHum = playerHum()
    if currentHum then pcall(function() currentHum.WalkSpeed = 16 end) end
    if speedBv then pcall(function() speedBv:Destroy() end); speedBv = nil end
    pcall(function() RunService:UnbindFromRenderStep("PH_Speed") end)
    for _, entry in pairs(espPlayer) do pcall(destroyEntry, entry) end
    for _, entry in pairs(espItem) do pcall(destroyEntry, entry) end
    table.clear(espPlayer)
    table.clear(espItem)
    pcall(function() Window:Destroy() end)
    getgenv().vibeexploits = nil
    getgenv().PotentHub = nil
end

