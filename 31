local fbSaved = nil

local function setFullbright(on)
    if on then
        if not fbSaved then
            fbSaved = { props = {}, effects = {} }
            for _, key in ipairs({
                "Brightness", "Ambient", "OutdoorAmbient", "ClockTime", "FogEnd", "FogStart",
                "GlobalShadows", "ExposureCompensation", "EnvironmentDiffuseScale", "EnvironmentSpecularScale",
            }) do
                fbSaved.props[key] = Lighting[key]
            end
            for _, e in ipairs(Lighting:GetChildren()) do
                if e:IsA("PostEffect") or e:IsA("Atmosphere") then
                    fbSaved.effects[e] = e.Enabled
                    e.Enabled = false
                end
            end
        end
        Lighting.Brightness = 2
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
        Lighting.ClockTime = 12
        Lighting.FogEnd = 1e6
        Lighting.FogStart = 1e6
        Lighting.GlobalShadows = false
        Lighting.ExposureCompensation = 0
        Lighting.EnvironmentDiffuseScale = 1
        Lighting.EnvironmentSpecularScale = 1
        for _, e in ipairs(Lighting:GetChildren()) do
            if e:IsA("PostEffect") or e:IsA("Atmosphere") then
                if fbSaved.effects[e] == nil then fbSaved.effects[e] = e.Enabled end
                e.Enabled = false
            end
        end
    elseif fbSaved then
        for key, value in pairs(fbSaved.props) do
            pcall(function() Lighting[key] = value end)
        end
        for e, enabled in pairs(fbSaved.effects) do
            if e and e.Parent then pcall(function() e.Enabled = enabled end) end
        end
        fbSaved = nil
    end
end

local xraySaved = {}

local function setXray(on)
    if on then
        for _, root in ipairs({ Workspace:FindFirstChild("Map"), Workspace:FindFirstChild("Lobby") }) do
            if root then
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("BasePart") and d.Transparency < 1 then
                        if xraySaved[d] == nil then
                            xraySaved[d] = d.LocalTransparencyModifier
                        end
                        d.LocalTransparencyModifier = 0.65
                    end
                end
            end
        end
    else
        for d, value in pairs(xraySaved) do
            if d and d.Parent then
                pcall(function() d.LocalTransparencyModifier = value end)
            end
        end
        table.clear(xraySaved)
    end
end

