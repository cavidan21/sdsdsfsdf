                                    interactions = interactions + 1
                                else
                                    blocked = blocked + 1
                                end
                                task.wait(0.12)
                            end
                        end
                        for _, d in ipairs(roundCache.clicks) do
                            if not State.RoundFarm then break end
                            if os.clock() < panicUntil then break end
                            if d.Parent and not CollectionService:HasTag(d, "_SurvivorInteractable") then
                                local parent = d.Parent
                                local ok = true
                                if parent:IsA("BasePart") then
                                    ok = safeTeleport(parent.Position + Vector3.new(0, 2, 0), 30, true)
                                end
                                if ok then
