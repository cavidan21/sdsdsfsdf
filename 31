-- lobby detection: dead/respawned players are in the lobby even while a round is running
local function isInLobby()
    local hum = playerHum()
    if not hum or hum.Health <= 0 then return true end
    local team = LocalPlayer.Team
    if team and team.Name == "Waiting" then return true end
    if gameState() ~= 5 then return true end
    local lobby = Workspace:FindFirstChild("Lobby")
    local root = playerRoot()
    if lobby and root then
        local ok, cf, size = pcall(function() return lobby:GetBoundingBox() end)
        if ok and cf and size then
            local p = cf:PointToObjectSpace(root.Position)
            local margin = 40
            if math.abs(p.X) <= size.X / 2 + margin
                and math.abs(p.Y) <= size.Y / 2 + margin
                and math.abs(p.Z) <= size.Z / 2 + margin then
                return true
            end
        end
    end
    return false
end

