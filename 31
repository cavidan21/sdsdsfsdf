local function teleportTo(pos)
    local root = playerRoot()
    local hum = playerHum()
    if not root or not hum or hum.Health <= 0 then return false end
    if typeof(pos) == "CFrame" then
        pcall(function() root.CFrame = pos end)
    else
        pcall(function() root.CFrame = CFrame.new(pos) end)
    end
    return true
end

local function waitForField(field, before, timeout)
    local deadline = os.clock() + (timeout or 0.7)
    local value = before
    while os.clock() < deadline do
        task.wait(0.1)
        value = currency(field)
        if value > before then return value end
    end
    return value
end

local function notify(title, content, duration)
