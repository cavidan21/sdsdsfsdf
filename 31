-- auto round (best effort)
local roundCache = { map = nil, at = 0, clicks = {}, prompts = {} }
local function refreshRoundCache(map)
    if roundCache.map == map and os.clock() - roundCache.at < 5 then return end
    roundCache.map = map
    roundCache.at = os.clock()
    table.clear(roundCache.clicks)
    table.clear(roundCache.prompts)
    for _, d in ipairs(map:GetDescendants()) do
        if d:IsA("ClickDetector") then
            table.insert(roundCache.clicks, d)
        elseif d:IsA("ProximityPrompt") then
            table.insert(roundCache.prompts, d)
        end
    end
end

task.spawn(function()
    while Running do
        if State.RoundFarm then
            if gameState() == 5 and isSurvivor(LocalPlayer) then
                local hum = playerHum()
